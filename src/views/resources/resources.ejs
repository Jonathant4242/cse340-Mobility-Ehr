<%- include('../partials/header') %>

<main>
  <h1><%= title %></h1>

  <% Object.entries(patientResources).forEach(([slug, resource]) => { %>
    <section>
      <h2><a href="/resources/<%= slug %>"><%= resource.title %></a></h2>
      <p><%= resource.description %></p>
    </section>
  <% }); %>
</main>

<%- include('../partials/footer') %>